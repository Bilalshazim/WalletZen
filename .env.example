# Firebase web config (Project settings → General → Your apps).
# Leave empty to run WalletZen in local-only mode (data stays in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the WalletZen API worker URL (see worker/ and README → Backend) — live electricity bills and the
# screenshot scanner. Leave empty for demo bills and no scanner. No AI key is needed (Cloudflare Workers AI).
VITE_API_URL=
