# Firebase web config (Project settings → General → Your apps).
# Leave empty to run WalletZen in local-only mode (data stays in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: your backend that proxies 1Bill / Kuickpay bill inquiry (see src/services/billAggregatorApi.js).
# Leave empty to enter utility bill amounts manually.
VITE_BILL_API_URL=

# Screenshot scanner (Gemini Vision). Put the real key in .env.local (gitignored).
# VITE_* values are inlined into the built JS — restrict the key in Google Cloud (see README).
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_MODEL=gemini-3.8-flash
