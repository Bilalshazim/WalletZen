# Firebase web config (Project settings → General → Your apps).
# Leave empty to run WalletZen in local-only mode (data stays in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the WalletZen API worker URL for live electricity bills (see worker/ and README → Utility auto-fetch).
# Leave empty to enter utility bill amounts manually.
VITE_BILL_API_URL=

# Screenshot scanner: no key here. The Anthropic key is a backend secret —
#   firebase functions:secrets:set ANTHROPIC_API_KEY   (see README → Backend)
